# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PORT: Server listening port (default: 3000)
PORT="3000"
NODE_ENV="development"

# CORS ALLOWLIST (comma-separated allowed browser origins in production)
# ALLOWED_ORIGINS="https://queueless.example.com"

# FIREBASE CONFIGURATION
# Provisioned automatically via AI Studio into firebase-applet-config.json
# VITE_FIREBASE_PROJECT_ID="gen-lang-client-0101089604"
# VITE_FIREBASE_DATABASE_ID="ai-studio-queuelessdigital-a56e71b1-a407-44c9-9332-e35a57121734"
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""

# SERVER-SIDE ADMIN CREDENTIALS (Production / Cloud Run)
# Leave unset on Cloud Run to use Application Default Credentials (ADC),
# or point to a service account JSON path in self-hosted environments.
# GOOGLE_APPLICATION_CREDENTIALS=""

# EXTERNAL NOTIFICATION GATEWAYS (Optional — in-app notifications active by default)
# SPARROW_SMS_TOKEN=""
# TWILIO_AUTH_TOKEN=""
# SENDGRID_API_KEY=""
# SMTP_HOST=""
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
